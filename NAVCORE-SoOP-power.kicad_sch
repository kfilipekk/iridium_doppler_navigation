	(text "3S-5S in on J2. TVS, then Q4 blocks a reversed pack." (exclude_from_sim no) (at 15.00 31.00 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "a443ac3e-9a77-4426-ad12-717b6f0a7a69"))
	(text "U8 makes +5V for the board, U20 a separate +5V for the payload, so servos and LEDs" (exclude_from_sim no) (at 15.00 35.50 0) (effects (font (size 1.6 1.6)) (justify left bottom)) (uuid "aad3eac6-cfcd-481d-bd33-5c1a966379c4"))
